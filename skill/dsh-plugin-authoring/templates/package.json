{
  "name": "dsh-my-plugin",
  "version": "<plugin-version>",
  "description": "<Host-only profile bundle description>",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<owner>/dsh-my-plugin.git"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0",
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  }
